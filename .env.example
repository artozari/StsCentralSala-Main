SUPABASE_URL=direccion-de-tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anonima
SUPABASE_SERVICE_KEY=tu-clave-de-servicio

# Tópico al que se suscribe para recibir los juegos de las mesas
MQTT_TOPIC_GAME=STS-MESAS/game/#

# Tópico al que se suscribe para recibir configuración de las mesas
MQTT_TOPIC_CONFIG=SimuSts/STS-Casino/Cli/Config/#

# Tópico servidor para publicar configuración
MQTT_TOPIC_CONFIG_SRV=SimuSts/STS-Casino/Srv/Config

# Prefijo de tópico servidor para solicitar/sincronizar juegos (GameSync)
MQTT_TOPIC_GAME_SYNC=STS-MESAS/STS-Casino/GameSync/

# Tópico al que se suscribe para recibir la respuesta de sincronización (GameSync)
MQTT_TOPIC_GAME_SYNC_SUB=STS-MESAS/GameSync/#

# Un broker MQTT por casino. El casinoCode debe coincidir con casino_table.casino_code en Supabase.
# Cada casino debe tener su propio broker/puerto para que los tópicos no se solapen entre casinos.
MQTT_CASINOS='[
  {"casinoCode":"CA_STFE","url":"wss://sts-santafe.sielcon.net:9104","username":"Cartel","password":"Mqtt123."},
  {"casinoCode":"CA_MEL","url":"wss://sts-santafe.sielcon.net:9105","username":"Cartel","password":"Mqtt123."}
]'
